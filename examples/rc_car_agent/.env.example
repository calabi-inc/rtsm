# Copy to .env (same folder) and fill in — .env is gitignored, never commit it.
# Alternative (no file needed): set a Windows user env var instead:
#   setx ANTHROPIC_API_KEY "sk-ant-..."
# Real environment variables always take precedence over this file.

# Used by planner.py for the E1 condition-(a) Haiku target-pick call.
# Without it, the planner runs the deterministic top1_no_llm path (logged per trial).
ANTHROPIC_API_KEY=sk-ant-your-key-here
