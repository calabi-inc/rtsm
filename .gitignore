# Gate records / development notes (eval/baselines/): kept LOCAL, never committed (founder, 2026-09-29).
# The determinism anchors they hold (session1: 124/65 @53, fingerprint ad6f71a5b89c8506) are stated in the docs.
eval/baselines/

# scripts/benchmark_*.py rewrite the packaged config in place and keep a per-PID backup while a run is live
rtsm/cfg/rtsm.yaml.*bak*

# Local run logs (stdout/stderr captured with shell redirection during live
# sessions and campaigns). Keep them under logs/, never at the repo root.
logs/

# Bags converted from recordings (scripts/recording_to_mcap.py): gigabytes, regenerable
recordings/*_bag/

# External datasets fetched for reader tests (TUM RGB-D bags etc.; see eval/datasets/external-corpus.md)
recordings/external/
